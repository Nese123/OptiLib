# ═══════════════════════════════════════════════════════════════
# OptiLib — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Security & Session Configuration
# Generate a secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Set to true when running behind HTTPS / reverse proxy
SESSION_COOKIE_SECURE=true

# Session TTL (inactivity timeout before cleaning up state, in seconds)
SESSION_TTL_SECONDS=7200

# Cleanup worker interval (in seconds)
CLEANUP_INTERVAL_SECONDS=30

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Public computation admits at most two small jobs or one large job.
# Capacity refusals preserve existing results.

# Rate Limiting (Flask-Limiter)
RATE_LIMIT_DEFAULT=120 per minute
# Optional: Redis storage for multi-process rate limiting (default is in-memory)
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0

# MolPort FTP Credentials (Optional — only required for automated monthly database updates)
# Do NOT commit production credentials to Git
MOLPORT_FTP_USER=
MOLPORT_FTP_PASS=
MOLPORT_FTP_HOST=ftp.molport.com
MOLPORT_FTP_PORT=21

# Public server; local legacy development can explicitly use development.
OPTILIB_ENV=production
TRUSTED_HOSTS=optilib.aittokallio.group
# Shared temporary runtime (use an absolute path outside Docker).
# OPTILIB_RUNTIME=/app/runtime
MAX_COMPOUNDS=100000
MAX_TARGETS=1000
MAX_MATRIX_CELLS=100000000
MAX_AFFINITY_ROWS=1000000
MAX_SESSION_UPLOAD_BYTES=268435456
MAX_XLSX_EXPANDED_BYTES=134217728
MAX_SESSION_FILES=100
MAX_SESSION_STORAGE_BYTES=6442450944
MAX_RUNTIME_STORAGE_BYTES=25769803776
MIN_FREE_STORAGE_BYTES=4294967296
MAX_SESSIONS=100
SMALL_JOB_MATRIX_CELLS=10000000
OPTIMIZATION_TIMEOUT_SECONDS=14400
STAGE_TIMEOUT_SECONDS=3600
JOB_STOP_GRACE_SECONDS=60
MAX_COMPUTATION_STARTS_PER_HOUR=4

# Host Nginx's internal artifact alias must match this directory.
RUNTIME_HOST_PATH=/var/lib/optilib/runtime
# Compose enables authenticated Nginx file delivery. Keep false for direct local HTTP.
OPTILIB_ACCEL_REDIRECT=false
