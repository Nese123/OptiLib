# ═══════════════════════════════════════════════════════════════
# OptiLib — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Security & Session Configuration
# Generate a secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Set to true when running behind HTTPS / reverse proxy
SESSION_COOKIE_SECURE=false

# Session TTL (inactivity timeout before cleaning up state, in seconds)
SESSION_TTL_SECONDS=1800

# Cleanup worker interval (in seconds)
CLEANUP_INTERVAL_SECONDS=300

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Rate Limiting (Flask-Limiter)
RATE_LIMIT_DEFAULT=120 per minute
# Optional: Redis storage for multi-process rate limiting (default is in-memory)
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0

# MolPort FTP Credentials (Optional — only required for automated monthly database updates)
# Do NOT commit production credentials to Git
MOLPORT_FTP_USER=
MOLPORT_FTP_PASS=
MOLPORT_FTP_HOST=ftp.molport.com
MOLPORT_FTP_PORT=21
